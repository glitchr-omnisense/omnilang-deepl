{
    "name": "omnilang/deepl",
    "type": "library",
    "description": "Omnilang's DeepL, under any PHP host: texts and HTML translated with formality as a preference, the source language detected, multilingual glossaries (v3) made, read and applied, documents (docx, pptx, xlsx, pdf, html...) uploaded, followed and downloaded - the key given by reference, DeepL's usage policy declared as data.",
    "keywords": [
        "deepl",
        "translation",
        "machine-translation",
        "glossary",
        "document-translation",
        "framework-agnostic",
        "omnilang"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnilang-deepl",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0@dev",
        "omnisense/omnilang": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnilang\\Deepl\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnilang\\Deepl\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
